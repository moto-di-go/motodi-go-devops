COMPOSE_PROJECT_NAME=motodigo
ENVIRONMENT=local

POSTGRES_DB=motodigo
POSTGRES_USER=motodigo
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_PORT=5432

GIS_ROUTES_YAOUNDE_PATH=/app/data/gis/routes_yaounde.gpkg

# Open-source geo stack (docker-compose.geo.yml). Disabled until that overlay is started.
GEO_STACK_PHOTON_ENABLED=false
GEO_STACK_PHOTON_BASE_URL=http://photon:2322
GEO_STACK_PHOTON_TIMEOUT_MS=1200
GEO_STACK_VALHALLA_ENABLED=false
GEO_STACK_VALHALLA_BASE_URL=http://valhalla:8002
GEO_STACK_VALHALLA_TIMEOUT_MS=2500
GEO_STACK_VALHALLA_COSTING=motorcycle
GEO_STACK_VALHALLA_ALTERNATES=2
PHOTON_PORT=2322
VALHALLA_PORT=8002
TILES_PORT=8088
PHOTON_REGION=africa
PHOTON_BASE_URL=https://r2.koalasec.org/public
VALHALLA_TILE_URL=https://download.geofabrik.de/africa/cameroon-latest.osm.pbf

MINIO_ROOT_USER=change-me
MINIO_ROOT_PASSWORD=change-me
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

KYC_STORAGE_ENDPOINT=http://object-storage:9000
KYC_STORAGE_REGION=us-east-1
KYC_STORAGE_BUCKET=motodigo-kyc
KYC_STORAGE_ACCESS_KEY=change-me
KYC_STORAGE_SECRET_KEY=change-me
KYC_STORAGE_PATH_STYLE=true
KYC_ENCRYPTION_ACTIVE_KEY_ID=local
KYC_ENCRYPTION_KEYS_LOCAL=bW90b2RpZ28tbG9jYWwta3ljLWtleS0zMi1ieXRlISE=
KYC_CHECKSUM_PEPPER=change-me-kyc-checksum-pepper
KYC_MAX_FILE_SIZE_BYTES=5242880

JWT_ISSUER_URL=http://localhost:8080
JWT_SECRET=change-me-to-at-least-32-bytes-for-hs256
JWT_AUDIENCE=motodi-go-api
OTP_PROVIDER=log
OTP_PEPPER=change-me-otp-pepper
AFRICAS_TALKING_USERNAME=your-app-username
AFRICAS_TALKING_API_KEY=your-api-key
AFRICAS_TALKING_SENDER_ID=your-sender-id
PUBLIC_API_BASE_URL=http://localhost:8080/api/v1
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

BACKEND_CORE_PORT=8081
BACKEND_AI_PORT=8000
API_GATEWAY_PORT=8080
ADMIN_DASHBOARD_PORT=3000
REDIS_PORT=6379

GATEWAY_RATE_LIMIT_AUTH_CAPACITY=5
GATEWAY_RATE_LIMIT_AUTH_REFILL_TOKENS=1
GATEWAY_RATE_LIMIT_AUTH_REFILL_PERIOD_SECONDS=120
GATEWAY_RATE_LIMIT_OTP_CAPACITY=5
GATEWAY_RATE_LIMIT_OTP_REFILL_TOKENS=1
GATEWAY_RATE_LIMIT_OTP_REFILL_PERIOD_SECONDS=120
GATEWAY_RATE_LIMIT_PAYMENT_CAPACITY=10
GATEWAY_RATE_LIMIT_PAYMENT_REFILL_TOKENS=10
GATEWAY_RATE_LIMIT_PAYMENT_REFILL_PERIOD_SECONDS=60
GATEWAY_RATE_LIMIT_CALLBACK_CAPACITY=60
GATEWAY_RATE_LIMIT_CALLBACK_REFILL_TOKENS=60
GATEWAY_RATE_LIMIT_CALLBACK_REFILL_PERIOD_SECONDS=60
GATEWAY_CORE_TIMEOUT=5s
GATEWAY_AI_TIMEOUT=3s
GATEWAY_MOBILE_MONEY_CALLBACK_ENABLED=true

MTN_CALLBACK_HMAC_SECRET=change-me-mtn-callback-hmac-secret
ORANGE_CALLBACK_HMAC_SECRET=change-me-orange-callback-hmac-secret
AGGREGATOR_CALLBACK_HMAC_SECRET=change-me-aggregator-callback-hmac-secret

MTN_MOMO_BASE_URL=https://placeholder.mtn.example
ORANGE_MONEY_BASE_URL=https://placeholder.orange.example
AGGREGATOR_BASE_URL=https://placeholder.aggregator.example
MOBILE_MONEY_CLIENT_MODE=stub
MOBILE_MONEY_PENDING_TTL=30m
PUSH_PROVIDER_BASE_URL=https://placeholder.push.example

IMAGE_TAG=local
REGISTRY=ghcr.io/motodi-go
