COMPOSE_PROJECT_NAME=motodigo-staging
ENVIRONMENT=staging
IMAGE_TAG=staging
REGISTRY=ghcr.io/motodi-go

POSTGRES_DB=motodigo
POSTGRES_USER=motodigo
POSTGRES_PASSWORD=replace-with-staging-db-password

JWT_SECRET=replace-with-staging-jwt-secret-at-least-32-bytes
JWT_ISSUER_URL=https://staging.example.com
JWT_AUDIENCE=motodi-go-api

OTP_PROVIDER=africas-talking
OTP_PEPPER=replace-with-staging-otp-pepper
AFRICAS_TALKING_BASE_URL=https://api.africastalking.com
AFRICAS_TALKING_USERNAME=moto-di-go
AFRICAS_TALKING_API_KEY=your-staging-api-key
# Use AFRICASTKNG until the custom MOTODIGO sender is approved by Africa's Talking.
AFRICAS_TALKING_SENDER_ID=AFRICASTKNG
AFRICAS_TALKING_ENQUEUE=true
AFRICAS_TALKING_CONNECT_TIMEOUT_MS=3000
AFRICAS_TALKING_READ_TIMEOUT_MS=5000

KYC_STORAGE_ENDPOINT=http://object-storage:9000
KYC_STORAGE_REGION=us-east-1
KYC_STORAGE_BUCKET=motodigo-kyc
KYC_STORAGE_ACCESS_KEY=replace-me
KYC_STORAGE_SECRET_KEY=replace-me
KYC_STORAGE_PATH_STYLE=true
KYC_ENCRYPTION_ACTIVE_KEY_ID=prod
KYC_ENCRYPTION_KEYS_PROD=replace-with-base64-32-byte-key
KYC_CHECKSUM_PEPPER=replace-with-kyc-checksum-pepper

GIS_ROUTES_YAOUNDE_PATH=/app/data/gis/routes_yaounde.gpkg

PUBLIC_API_BASE_URL=https://staging.example.com/api/v1
API_BASE_URL=http://api-gateway:8080/api/v1
CORS_ALLOWED_ORIGINS=https://staging.example.com
